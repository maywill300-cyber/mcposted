# Copy this file to .env.local for local testing, and add the same values
# in Vercel under Project Settings > Environment Variables.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Keep this one secret. Never put it in client code or share it.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic: console.anthropic.com > API Keys (used for AI moderation)
ANTHROPIC_API_KEY=
MODERATION_MODEL=claude-haiku-5-5

# When lunch ratings open each school day (24-hour time, Eastern)
LUNCH_RATINGS_OPEN_AT=13:40
